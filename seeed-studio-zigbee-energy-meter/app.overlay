/*
 * Project overlay — always applied regardless of board target. Forced into
 * the DTS pipeline via EXTRA_DTC_OVERLAY_FILE in CMakeLists.txt.
 *
 * Wires the hardware pulse-counting chain that runs during System-ON sleep
 * (see src/hw_pulse_counter.c and issue #7):
 *
 *   - `comp` re-configured as an LPCOMP (Low-Power COMParator) with the
 *     phototransistor on AIN0 (P0.02 = XIAO A0) as its input and VDD*3/8
 *     (~1.24 V @ 3.3 V VDD, 1.125 V @ 3.0 V VDD) as its reference. HYST is
 *     enabled to reject jitter near the threshold with no CPU wake — see
 *     hw_pulse_counter.c for the noise-filter reasoning.
 *   - `timer2` brought up so hw_pulse_counter can drive it in counter mode
 *     via nrfx. (TIMER0 is the radio driver's; TIMER1 is the 802.15.4
 *     driver's — enabling either fails Kconfig or races the stack. TIMER2
 *     is the lowest-numbered free instance.)
 *   - `gpiote` brought up so the bench D7 falling-edge inject-path
 *     (Pi → xiao-pulse.sh) can be routed to the same TIMER via PPI. Zephyr's
 *     GPIO driver on nRF also uses this instance, which is fine — the nrfx
 *     GPIOTE allocator coordinates channel ownership between the two.
 *
 * Retained:
 *   - User button on XIAO D6 (P1.11), still driven by Zephyr GPIO for
 *     Zigbee join / factory-reset. Bench rig: Pi BCM17 → D6.
 *
 * Re-added for #8:
 *   - The `zephyr,user` ADC channel + `&adc` block, for battery voltage.
 *     This is NOT the 10 Hz sample loop that was removed after #7 — it is
 *     a single one-shot conversion on the 5-minute report tick. The
 *     distinction matters for power: Zephyr's SAADC driver enables the
 *     peripheral in adc_context_start_sampling() and disables it again in
 *     the END IRQ (zephyr/drivers/adc/adc_nrfx_saadc.c), so SAADC.ENABLE
 *     is non-zero only for the ~10 µs conversion. A peripheral left
 *     enabled requests PCLK16M and pins HFCLK — that was the ~1.5 mA
 *     anchor UARTE0/TWIM0 caused below, and it is exactly what a sampling
 *     *loop* would reintroduce.
 *
 * Removed (relative to pre-#7):
 *   - The `sw1` / `pulse_input` gpio-keys entry — D7 is no longer a Zephyr
 *     GPIO consumer; hw_pulse_counter drives it directly through nrfx
 *     GPIOTE. Pin assignment (P1.12) is documented in that C file.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/adc/adc.h>

/ {
	buttons {
		compatible = "gpio-keys";

		user_button: user_button {
			gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "User button (XIAO D6 = P1.11)";
		};
	};

	aliases {
		sw0 = &user_button;
	};

	/*
	 * Battery-voltage sense channel (#8). Consumed via
	 * ADC_DT_SPEC_GET(DT_PATH(zephyr_user)) in zigbee_app.c.
	 */
	zephyr,user {
		io-channels = <&adc 7>;
	};
};

&comp {
	status = "okay";
	compatible = "nordic,nrf-lpcomp";
	psel = "AIN0";
	refsel = "VDD_3_8";
	enable-hyst;
};

&timer2 {
	status = "okay";
};

/*
 * SAADC for battery voltage (#8), per the design doc's "sample battery
 * (SAADC on VDD)".
 *
 * Input is the SoC-internal VDD tap (NRF_SAADC_VDD), not an AIN pin:
 *   - no pin to wire, no divider, no enable GPIO, so nothing to conflict
 *     with the LPCOMP already sitting on AIN0;
 *   - the XIAO's own battery divider (P0.31 + P0.14 enable) would burn
 *     current through the divider whenever it is enabled and differs
 *     between XIAO variants.
 *
 * Gain 1/6 against the 0.6 V internal reference gives a 3.6 V full scale,
 * which covers a fresh 2x AAA pack (~3.2 V) and the 3.3 V bench rail with
 * headroom. Channel index 7 is arbitrary — VDD is not pin-mapped.
 *
 * NOTE: this reads the rail the SoC is actually running from. On the
 * bench that is the Pi 3V3 supply, so battery percentage will read 100 %
 * until the board is on cells.
 */
&adc {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS, 10)>;
		zephyr,input-positive = <NRF_SAADC_VDD>;
		zephyr,resolution = <12>;
	};
};

/*
 * TIMER3: width-measure gate for the min-pulse-width filter (issue #59,
 * see docs/working/2026-07-29-min-pulse-width-spike.md). Timer mode,
 * 1 MHz, 16-bit; CC[0] holds the threshold in µs, CC0_STOP short freezes
 * the timer once the threshold is reached so PCLK16M is only requested
 * while a pulse is in flight. TIMER0/1/2 are already claimed
 * (radio / 802.15.4 / this project's counter); TIMER3 is the next free
 * instance.
 */
&timer3 {
	status = "okay";
};

&gpiote {
	status = "okay";
};

/*
 * The XIAO Sense's IMU regulator disable used to live here. It moved to
 * overlays/sense.overlay, which CMakeLists.txt appends only for board
 * targets ending in "sense".
 *
 * It had to move: &lsm6ds3tr_c and the two regulator nodes exist only in
 * the Sense variant's board DT, so referencing them from this file — which
 * is force-loaded for every target — made the plain xiao_ble/nrf52840
 * build fail at DTS parse time. See #75.
 *
 * Everything below this point applies to both variants.
 */

/*
 * Kill the two on-board EasyDMA peripherals that were the real ~1.5 mA
 * anchor. When their ENABLE register is non-zero, UARTE and TWIM instances
 * request PCLK16M, which auto-starts HFCLK on HFINT and pins the SoC at
 * the ~1.6 mA "System-ON idle, HFCLK on" datasheet floor even with the
 * CPU in WFE.
 *
 * SWD peripheral snapshot showed UARTE0.ENABLE=8 and TWIM0.ENABLE=6 on
 * every build to date. Neither is used by this app on rtt.conf builds:
 *
 * - UART0 was left enabled by the board DTS as the default console. In
 *   this build CONFIG_UART_CONSOLE=n / CONFIG_LOG_BACKEND_UART=n / no
 *   shell — nothing needs it. Disable at the DT level so Zephyr never
 *   probes the driver and never touches ENABLE.
 *
 * - I2C0 hosted the LSM6DS3TR-C IMU (disabled above). With the child
 *   node status=disabled, Zephyr still probes the parent bus driver
 *   which enables the peripheral. Explicit disable at the parent level
 *   is what actually stops the ENABLE write.
 *
 * If dev.conf ever needs I2C or UART back (bench sensor, uart console),
 * re-enable via the dev.conf-specific overlay path instead of undoing
 * this — the battery build must ship with both off.
 */
&uart0 {
	status = "disabled";
};

&i2c0 {
	status = "disabled";
};
