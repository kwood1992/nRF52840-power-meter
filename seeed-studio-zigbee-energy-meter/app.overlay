/*
 * Project overlay — always applied regardless of board target. Forced into
 * the DTS pipeline via EXTRA_DTC_OVERLAY_FILE in CMakeLists.txt.
 *
 * Wires the hardware pulse-counting chain that runs during System-ON sleep
 * (see src/hw_pulse_counter.c and issue #7):
 *
 *   - `comp` re-configured as an LPCOMP (Low-Power COMParator) with the
 *     phototransistor on AIN0 (P0.02 = XIAO A0) as its input and VDD*3/8
 *     (~1.24 V @ 3.3 V VDD, 1.125 V @ 3.0 V VDD) as its reference. HYST is
 *     enabled to reject jitter near the threshold with no CPU wake — see
 *     hw_pulse_counter.c for the noise-filter reasoning.
 *   - `timer2` brought up so hw_pulse_counter can drive it in counter mode
 *     via nrfx. (TIMER0 is the radio driver's; TIMER1 is the 802.15.4
 *     driver's — enabling either fails Kconfig or races the stack. TIMER2
 *     is the lowest-numbered free instance.)
 *   - `gpiote` brought up so the bench D7 falling-edge inject-path
 *     (Pi → xiao-pulse.sh) can be routed to the same TIMER via PPI. Zephyr's
 *     GPIO driver on nRF also uses this instance, which is fine — the nrfx
 *     GPIOTE allocator coordinates channel ownership between the two.
 *
 * Retained:
 *   - User button on XIAO D6 (P1.11), still driven by Zephyr GPIO for
 *     Zigbee join / factory-reset. Bench rig: Pi BCM17 → D6.
 *
 * Removed (relative to pre-#7):
 *   - The `zephyr,user` ADC channel + `&adc` block — the 10 Hz SAADC sample
 *     loop is gone; battery voltage sensing (issue #8) will re-add SAADC on
 *     a different channel when that lands.
 *   - The `sw1` / `pulse_input` gpio-keys entry — D7 is no longer a Zephyr
 *     GPIO consumer; hw_pulse_counter drives it directly through nrfx
 *     GPIOTE. Pin assignment (P1.12) is documented in that C file.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	buttons {
		compatible = "gpio-keys";

		user_button: user_button {
			gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "User button (XIAO D6 = P1.11)";
		};
	};

	aliases {
		sw0 = &user_button;
	};
};

&comp {
	status = "okay";
	compatible = "nordic,nrf-lpcomp";
	psel = "AIN0";
	refsel = "VDD_3_8";
	enable-hyst;
};

&timer2 {
	status = "okay";
};

&gpiote {
	status = "okay";
};

/*
 * Battery-mode current fix — kill the XIAO Sense's IMU regulator so the
 * LSM6DS3TR-C doesn't draw its ~0.6-1.7 mA normal-mode quiescent current.
 *
 * Root cause: the SENSE variant's board DT declares a fixed regulator on
 * P1.08 with `regulator-boot-on`, which Zephyr's regulator subsystem
 * enables at boot. The IMU sensor driver then fails to init (our overlay
 * doesn't use its I2C bus) but the regulator stays ON — sensor keeps
 * drawing current until an explicit disable.
 *
 * We don't use the IMU in this app. Disable both the sensor node (so no
 * driver instance is created) and the regulator node (so the P1.08 enable
 * pin doesn't drive HIGH at boot).
 *
 * The regulator node has no explicit label in the upstream board DTS —
 * refer to it by path via &{/lsm6ds3tr-c-en}. Same for the microphone
 * regulator on P1.10 (msm261d3526hicpm-c-en) which is off by default but
 * belt-and-braces disable is cheap.
 */
&lsm6ds3tr_c {
	status = "disabled";
};

&{/lsm6ds3tr-c-en} {
	status = "disabled";
};

&{/msm261d3526hicpm-c-en} {
	status = "disabled";
};

/*
 * Kill the two on-board EasyDMA peripherals that were the real ~1.5 mA
 * anchor. When their ENABLE register is non-zero, UARTE and TWIM instances
 * request PCLK16M, which auto-starts HFCLK on HFINT and pins the SoC at
 * the ~1.6 mA "System-ON idle, HFCLK on" datasheet floor even with the
 * CPU in WFE.
 *
 * SWD peripheral snapshot showed UARTE0.ENABLE=8 and TWIM0.ENABLE=6 on
 * every build to date. Neither is used by this app on rtt.conf builds:
 *
 * - UART0 was left enabled by the board DTS as the default console. In
 *   this build CONFIG_UART_CONSOLE=n / CONFIG_LOG_BACKEND_UART=n / no
 *   shell — nothing needs it. Disable at the DT level so Zephyr never
 *   probes the driver and never touches ENABLE.
 *
 * - I2C0 hosted the LSM6DS3TR-C IMU (disabled above). With the child
 *   node status=disabled, Zephyr still probes the parent bus driver
 *   which enables the peripheral. Explicit disable at the parent level
 *   is what actually stops the ENABLE write.
 *
 * If dev.conf ever needs I2C or UART back (bench sensor, uart console),
 * re-enable via the dev.conf-specific overlay path instead of undoing
 * this — the battery build must ship with both off.
 */
&uart0 {
	status = "disabled";
};

&i2c0 {
	status = "disabled";
};
