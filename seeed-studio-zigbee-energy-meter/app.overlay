/*
 * Project overlay — always applied regardless of board target. Forced into
 * the DTS pipeline via EXTRA_DTC_OVERLAY_FILE in CMakeLists.txt.
 *
 * Adds two things:
 *  - An ADC channel on AIN0 (XIAO A0 / D0 / P0.02) for the phototransistor,
 *    exposed through zephyr,user for main.c.
 *  - A bench pulse-source button on P0.03 (XIAO A1 / D1). Wire a momentary
 *    button between D1 and GND — internal pull-up + active-low means each
 *    press pulls the pin LOW and fires a falling-edge interrupt. Same
 *    software path we'll eventually feed with LPCOMP+PPI+TIMER.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	zephyr,user {
		io-channels = <&adc 0>;
	};

	buttons {
		compatible = "gpio-keys";

		/*
		 * User button on XIAO D6 (P1.11). Long-term this is the Zigbee
		 * join / factory-reset button; short-term we use each press as
		 * a bench pulse for validating the accumulator + Zigbee report
		 * pipeline. Once real Zigbee handlers land, this alias moves
		 * into a proper button abstraction with short/long-press.
		 */
		user_button: user_button {
			gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "User button (XIAO D6 = P1.11)";
		};
	};

	aliases {
		sw0 = &user_button;
	};
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN0>;
		zephyr,resolution = <12>;
	};
};
