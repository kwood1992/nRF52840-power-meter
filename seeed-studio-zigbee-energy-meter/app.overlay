/*
 * Project overlay — always applied regardless of board target. Forced into
 * the DTS pipeline via EXTRA_DTC_OVERLAY_FILE in CMakeLists.txt.
 *
 * Since #7, the phototransistor's pulse-counting path is
 * LPCOMP → PPI → TIMER (all nrfx, configured in src/pulse_source_hw.c) —
 * no DT overlay needed for the pulse chain. LPCOMP owns AIN0 (P0.02) at
 * runtime and doesn't need a devicetree binding.
 *
 * What remains here is the D6 user button used by #4 for Zigbee join /
 * factory reset.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	buttons {
		compatible = "gpio-keys";

		/*
		 * User button on XIAO D6 (P1.11). Short-press (<1 s) →
		 * network steering, long-press (≥3 s) → factory reset;
		 * see docs/working/2026-07-22-zigbee-join.md.
		 */
		user_button: user_button {
			gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "User button (XIAO D6 = P1.11)";
		};
	};

	aliases {
		sw0 = &user_button;
	};
};
