/*
 * Project overlay — always applied regardless of board target. Forced into
 * the DTS pipeline via EXTRA_DTC_OVERLAY_FILE in CMakeLists.txt.
 *
 * Wires the hardware pulse-counting chain that runs during System-ON sleep
 * (see src/hw_pulse_counter.c and issue #7):
 *
 *   - `comp` re-configured as an LPCOMP (Low-Power COMParator) with the
 *     phototransistor on AIN0 (P0.02 = XIAO A0) as its input and VDD*3/8
 *     (~1.24 V @ 3.3 V VDD, 1.125 V @ 3.0 V VDD) as its reference. HYST is
 *     enabled to reject jitter near the threshold with no CPU wake — see
 *     hw_pulse_counter.c for the noise-filter reasoning.
 *   - `timer2` brought up so hw_pulse_counter can drive it in counter mode
 *     via nrfx. (TIMER0 is the radio driver's; TIMER1 is the 802.15.4
 *     driver's — enabling either fails Kconfig or races the stack. TIMER2
 *     is the lowest-numbered free instance.)
 *   - `gpiote` brought up so the bench D7 falling-edge inject-path
 *     (Pi → xiao-pulse.sh) can be routed to the same TIMER via PPI. Zephyr's
 *     GPIO driver on nRF also uses this instance, which is fine — the nrfx
 *     GPIOTE allocator coordinates channel ownership between the two.
 *
 * Retained:
 *   - User button on XIAO D6 (P1.11), still driven by Zephyr GPIO for
 *     Zigbee join / factory-reset. Bench rig: Pi BCM17 → D6.
 *
 * Removed (relative to pre-#7):
 *   - The `zephyr,user` ADC channel + `&adc` block — the 10 Hz SAADC sample
 *     loop is gone; battery voltage sensing (issue #8) will re-add SAADC on
 *     a different channel when that lands.
 *   - The `sw1` / `pulse_input` gpio-keys entry — D7 is no longer a Zephyr
 *     GPIO consumer; hw_pulse_counter drives it directly through nrfx
 *     GPIOTE. Pin assignment (P1.12) is documented in that C file.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	buttons {
		compatible = "gpio-keys";

		user_button: user_button {
			gpios = <&gpio1 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			label = "User button (XIAO D6 = P1.11)";
		};
	};

	aliases {
		sw0 = &user_button;
	};
};

&comp {
	status = "okay";
	compatible = "nordic,nrf-lpcomp";
	psel = "AIN0";
	refsel = "VDD_3_8";
	enable-hyst;
};

&timer2 {
	status = "okay";
};

&gpiote {
	status = "okay";
};
